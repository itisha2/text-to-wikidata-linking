<mxfile host="Electron" modified="2026-10-22T00:00:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="pipeline-arch" name="architecture">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="input" value="&lt;b&gt;Input&lt;/b&gt;&lt;br/&gt;unstructured text&lt;br/&gt;(multi-sentence paragraphs)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="195" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Text processing &amp;amp; term extraction&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;spaCy (small): sentences, POS, noun phrases, lemmas, NER&lt;br/&gt;&lt;br/&gt;+ d1-omni:600m typed NER decisions &lt;i&gt;(Decision 1: coverage 65% &amp;#8594; 90%)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;mention expansion: lemma, stem, WordNet synonyms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. Candidate retrieval&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;wbsearchentities per mention form, queried in parallel &lt;i&gt;(Decision 2: recall 75.6% vs 38.9% for full-text)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;tuned for recall — selection left to the ranker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. KG enrichment&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;1-hop Wikidata triples per candidate&lt;br/&gt;&lt;br/&gt;NetworkX document graph: nodes = QIDs, edges = wdt: properties (RDF/SKOS terms kept)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="140" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. Ranker — final: v2 (embed + graph)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;embeddinggemma cosine: &amp;#8220;mention + sentence&amp;#8221; vs &amp;#8220;label: description (aliases)&amp;#8221; + &amp;#8804;12 verbalised graph facts&lt;br/&gt;&lt;br/&gt;lexical priors: search rank 0.15/rank, exact match +0.10, Levenshtein &amp;#8722;0.05&lt;br/&gt;&lt;br/&gt;graph coherence bonus (w = 0.2)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;63.3% acc / 0.67 MRR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#D5E8D4;strokeColor=#82B366;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="115" width="210" height="230" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Output&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;JSON per mention: QID, rank, score, confidence, evidence (description + graph facts), ranked alternatives" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#333333;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="165" width="150" height="130" as="geometry" />
        </mxCell>

        <mxCell id="wikidata" value="&lt;b&gt;Wikidata API&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="20" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sqlite" value="&lt;b&gt;SQLite candidate store&lt;/b&gt;&lt;br/&gt;QID, label, description, aliases, 1-hop triples" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="390" width="220" height="90" as="geometry" />
        </mxCell>

